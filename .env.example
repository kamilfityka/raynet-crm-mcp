# Public base URL of this MCP server (used in tokens and logs).
PUBLIC_BASE_URL=http://localhost:3000

# Port to listen on.
PORT=3000

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Comma-separated list of bearer tokens that the /admin/connect endpoint accepts
# to register new tenants. Generate strong random values; rotate by editing.
# Example: ADMIN_TOKENS=changeme1,changeme2
ADMIN_TOKENS=

# Where to persist tenant credentials (JSON file). Keep outside the repo.
# In production use a real secret manager (AWS KMS / GCP KMS / Vault).
CREDENTIALS_FILE=./data/tenants.json

# Optional: encryption key for credentials at rest. 32 bytes, base64-encoded.
# If empty, credentials are stored as plaintext (NOT for production).
CREDENTIALS_KEY=

# Default Raynet region for new tenants if they don't specify one.
# One of: cz | sk | com | eu
DEFAULT_RAYNET_REGION=eu
